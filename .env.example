# Generate with bash install.sh, or set your own random secrets before Compose.
# ADMIN_PASSWORD is used only on first run or migration from admin/admin.
ADMIN_PASSWORD=
FLASK_SECRET_KEY=
# Optional TOTP shared secret; enter its current 6-digit code when logging in.
ADMIN_TOTP_SECRET=
# Keep true with an HTTPS reverse proxy. false only for a local SSH tunnel.
COOKIE_SECURE=true
WEBHOOK_PORT=1488
LOG_LEVEL=INFO
